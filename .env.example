# ============================================================================
# DRYLAB-Bench — API Keys
# ============================================================================
# Copy to .env and fill in your keys:
#   cp .env.example .env

# --- API 中转站 (primary) ---
export DRYLAB_API_KEY=sk-xxxxxxxxxxxxx
export DRYLAB_API_BASE_URL=https://your-api-proxy.example.com

# --- Direct API (fallback, uncomment if needed) ---
# export OPENAI_API_KEY=sk-your-key-here
# export ANTHROPIC_API_KEY=sk-ant-your-key-here
# export GOOGLE_API_KEY=your-key-here

# --- Direct-API models (kimi-k3 / glm): 值只放本文件，config 里一律写 $VAR 引用 ---
# export DRYLAB_MOONSHOT_API_KEY=sk-your-moonshot-key
# export DRYLAB_GLM_API_KEY=your-zhipu-key

# --- Optional usage metering (opt-in): 每次成功响应 append 一行 token 用量 ---
# export DRYLAB_USAGE_LOG=/abs/path/usage.jsonl
